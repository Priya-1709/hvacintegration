# ServiceTitan OAuth 2.0 Configuration (Recommended)
# OAuth client credentials for authentication
ST_CLIENT_ID=your_oauth_client_id_here
ST_CLIENT_SECRET=your_oauth_client_secret_here

# ServiceTitan API Configuration
# Required: Your ServiceTitan tenant ID (found in Developer Portal)
ST_TENANT_ID=your_tenant_id_here

# Required: Your ServiceTitan booking provider ID (configured in ServiceTitan Settings > Booking Providers)
ST_BOOKING_PROVIDER_ID=your_booking_provider_id_here

# Optional: ServiceTitan API app key for additional identification
ST_APP_KEY=your_app_key_here

# OAuth Authentication Configuration
# OAuth token endpoint URL (defaults to integration environment)
ST_AUTH_URL=https://auth-integration.servicetitan.io/connect/token

# Token refresh buffer in seconds (default: 300 = 5 minutes before expiry)
ST_TOKEN_REFRESH_BUFFER=300

# Legacy Configuration (Deprecated - use OAuth above instead)
# Required: Your ServiceTitan API access token with job-types:read and booking-provider:write permissions
SERVICETITAN_ACCESS_TOKEN=your_access_token_here

# Required: Your ServiceTitan tenant ID (found in Developer Portal)
SERVICETITAN_TENANT_ID=your_tenant_id_here

# Required: Your ServiceTitan booking provider ID (configured in ServiceTitan Settings > Booking Providers)
SERVICETITAN_PROVIDER_ID=your_booking_provider_id_here

# Optional: ServiceTitan API app key
SERVICETITAN_APP_KEY=your_app_key_here

# Optional: ServiceTitan API base URL (defaults to https://api.servicetitan.io if not set)
SERVICETITAN_API_BASE_URL=https://api.servicetitan.io

# Development/Testing Configuration
# Uncomment and set these for local development if needed
# DEBUG=true
# LOG_LEVEL=INFO